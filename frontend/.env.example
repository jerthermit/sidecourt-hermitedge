# Leave empty for local development through the Vite /api proxy.
# Set this to the Railway service origin in Vercel, without a trailing slash.
VITE_API_URL=

# Public showcase: each visitor gets an isolated, temporary board. Match PUBLIC_DEMO on the server.
VITE_PUBLIC_DEMO=false

# Local recording only. Put the value in an ignored .env.demo.local file and run npm run demo.
# Never use a client or production key here.
VITE_DEMO_OPERATOR_ACCESS_KEY=
