PORT=3001
HOST=0.0.0.0
OPERATOR_ACCESS_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=./data/pickleball.db
REQUEST_BODY_LIMIT_BYTES=65536
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Railway's nearest reverse proxy; use 0 when running directly without a proxy.
TRUST_PROXY_HOPS=1
DEMO_SEED=false

# Public showcase only: isolated in-memory visitor boards, never a shared client database.
PUBLIC_DEMO=false
VISITOR_TTL_MINUTES=120
MAX_VISITORS=30
